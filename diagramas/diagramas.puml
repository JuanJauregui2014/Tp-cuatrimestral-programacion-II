@startuml

title Gestión de Pedidos — Fogón del Barrio

class Restaurante {
    -nombre: string
    -menu: Menu
    -estaciones: Estacion[]
    -pedidosActivos: Map<number, Pedido>
    -pedidosFinalizados: Map<number, Pedido>
    -descuentos: Descuento[]
    __ Getters y Setters __
    +agregarPedido(pedido: Pedido): void
    +confirmarPedido(nroDePedido: number, distribuidor: DistribuidorPedidos): void
    +consultarHistorial(): Map<number, Pedido>
    +facturarPedido(nroDePedido: number, medioPago: MedioDePago): void
}

class Menu {
    -categorias: List<Categoria>
    -productos: List<Producto>
    -combos: List<Combo>
    __ Getters y Setters __
}

class Categoria {
    -nombre: String
    __ Getters y Setters __
}

interface ElementoMenu {
    +getPrecio(): number
    +getNombre(): String
}

class Combo {
    -nombre: String
    -productos: ReadonlyArray<Producto>
    -beneficio: ComboBeneficio
    __ Getters y Setters __
    +getPrecio(): number
    +getNombre(): String
    +getProductos(): ReadonlyArray<Producto>
}

interface ComboBeneficio {
    +aplicarBeneficio(precio: number): number
}

class ComboPorcentual {
    -porcentajeDescuento: number
    __ Getters y Setters __
    +aplicarBeneficio(precio: number): number
}

class ComboPrecioFijo {
    -precioFijo: number
    __ Getters y Setters __
    +aplicarBeneficio(precio: number): number
}

abstract class Pedido {
    -numeroPedido: number
    -nombreCliente: string
    -costoEnvio: number
    -fecha: Date
    -estado: EstadoPedido
    -items: Item[]
    -historialComandos: ComandoPedido[]
    -totalBruto: number
    -descuento: number
    -totalCobrado: number
    -medioPagoElegido: MedioDePago
    __ Getters y Setters __
    +agregarItem(item: Item): void
    +quitarItem(item: Item): void
    +deshacerUltimaModificacion(): void
    +confirmarPedido(): void
    +puedeFacturarse(): boolean
    +calcularTotalBruto(): void
    +aplicarDescuento(descuentos: Descuento[]): void
    +calcularTotalFinal(): void
}

class PedidoSalon {
    -numeroMesa: int
    -mozo: String
    __ Getters y Setters __
}

class PedidoRetirar {
    -horarioRetiro: Date
    __ Getters y Setters __
}

class PedidoEnvioPropio {
    -direccion: String
    -costoEnvio: number
    __ Getters y Setters __
}

class Item {
    -cantidad: number
    -estado: EstadoItem
    -elemento: ElementoMenu
    -preparaciones: Item[]
    __ Getters y Setters __
    +registrarPreparaciones(preparaciones: Item[]): void
    +avanzarEstado(): void
    +esModificable(): boolean
}

class Estacion {
    -nombre: String
    -categorias: Categoria[]
    -items: Item[]
    __ Getters y Setters __
    +agregarItem(item: Item): void
    +avanzarItem(item: Item): void
    +puedePreparar(categoria: Categoria): boolean
    +obtenerCarga(): number
}

class Producto {
    -nombre: String
    -precioDeVenta: number
    -categoria: Categoria
    __ Getters y Setters __
    +getCategoria(): Categoria
    +getPrecio(): number
    +getNombre(): String
}

interface MedioDePago {
    +procesarPago(monto: number): boolean
}

class Efectivo {
    -tipoDePago: string
    __ Getters y Setters __
}

class TarjetaDebito {
    -numeroTarjeta: String
    -tipoDePago: string
    __ Getters y Setters __
}

class TarjetaCredito {
    -numeroTarjeta: String
    -cuotas: int
    -tipoDePago: string
    __ Getters y Setters __
}

class BilleteraVirtual {
    -alias: String
    -tipoDePago: string
    __ Getters y Setters __
}

interface Descuento {
    +aplicable(pedido: Pedido, medioPago: MedioDePago): boolean
    +calcularMontoDescuento(pedido: Pedido, medioPago: MedioDePago): number
}

class DescuentoEfectivo {
    -efectivo: string
    -porcentajeDescuento: number
    __ Getters y Setters __
    +aplicable(pedido: Pedido, medioPago: MedioDePago): boolean
    +calcularMontoDescuento(pedido: Pedido, medioPago: MedioDePago): number
}

class DescuentoDiaEspecial {
    -diaDescuento: DiaSemana
    -porcentajeDescuento: number
    __ Getters y Setters __
    +aplicable(pedido: Pedido, medioPago: MedioDePago): boolean
    +calcularMontoDescuento(pedido: Pedido, medioPago: MedioDePago): number
}

enum EstadoPedido {
    EN_CONSTRUCCION
    CONFIRMADO
    LISTO
    FACTURADO
}

enum EstadoItem {
    PENDIENTE
    EN_PREPARACION
    LISTO
}

enum DiaSemana {
    LUNES
    MARTES
    MIERCOLES
    JUEVES
    VIERNES
    SABADO
    DOMINGO
}

' --- Command: deshacer modificaciones ---
interface ComandoPedido {
    +ejecutar(): void
    +deshacer(): void
}

class AgregarItemCommand {
    -items: Item[]
    -item: Item
    +ejecutar(): void
    +deshacer(): void
}

class QuitarItemCommand {
    -items: Item[]
    -item: Item
    -posicionOriginal: number
    +ejecutar(): void
    +deshacer(): void
}

AgregarItemCommand ..|> ComandoPedido
QuitarItemCommand ..|> ComandoPedido
Pedido *-- "0..*" ComandoPedido : historialComandos
AgregarItemCommand --> Item : agrega / revierte
QuitarItemCommand --> Item : quita / restaura

' --- Strategy: selección de estaciones ---
interface EstrategiaSeleccion {
    +seleccionarEstacion(categoria: Categoria, estaciones: Estacion[]): Estacion
}

class PrimeraCompatible {
    +seleccionarEstacion(categoria: Categoria, estaciones: Estacion[]): Estacion
}

class DistribuidorPedidos {
    -estrategia: EstrategiaSeleccion
    +buscarEstacion(categoria: Categoria, estaciones: Estacion[]): Estacion
    +distribuirPedido(pedido: Pedido, estaciones: Estacion[]): void
}

PrimeraCompatible ..|> EstrategiaSeleccion
DistribuidorPedidos --> EstrategiaSeleccion : utiliza
DistribuidorPedidos ..> Pedido : distribuye
DistribuidorPedidos ..> Estacion : asigna ítems
Restaurante ..> DistribuidorPedidos : confirma mediante
Estacion --> Categoria : prepara

' --- Relaciones estructurales existentes ---
Restaurante *-- Menu
Restaurante *-- Estacion
Restaurante *-- Pedido
Restaurante ..> MedioDePago

Combo ..|> ElementoMenu
Producto ..|> ElementoMenu

Menu *-- Categoria
Menu *-- Producto
Menu *-- Combo

ComboPorcentual ..|> ComboBeneficio
ComboPrecioFijo ..|> ComboBeneficio
Combo --> ComboBeneficio
Combo o-- Producto

Pedido *-- Item
Item --> ElementoMenu
Item o-- Item : preparaciones
Estacion o-- Item

Efectivo ..|> MedioDePago
TarjetaDebito ..|> MedioDePago
TarjetaCredito ..|> MedioDePago
BilleteraVirtual ..|> MedioDePago

Pedido <|-- PedidoSalon
Pedido <|-- PedidoRetirar
Pedido <|-- PedidoEnvioPropio

Restaurante *-- Descuento

@enduml
