abstract class Pedido {
    -numeroPedido: int
    -nombreCliente: String
    -fecha: Date
    -estado: EstadoPedido
    -items: List<Item>
    -historialModificaciones: Stack<Item>
    -totalBruto: number
    -descuento: number
    -totalCobrado: number
__ Getters y Setters __
    +agregarItem(elemento: ElementoMenu, cantidad: int)
    +quitarItem(item: Item)
    +deshacerUltimaModificacion()
    +confirmarPedido()
    +puedeFacturarse(): boolean
    +calcularTotalBruto(): number
    +aplicarDescuento(): number
    +calcularTotalFinal(medioPago: MedioDePago, diaActual: DiaSemana): number
}

class PedidoSalon {
    -numeroMesa: int
    -mozo: String
__ Getters y Setters __
}

class PedidoRetirar {
    -horarioRetiro: Date
__ Getters y Setters __
}

class PedidoEnvioPropio {
    -direccion: String
    -costoEnvio: number
__ Getters y Setters __
}

class Item {
    -cantidad: int
    -estado: EstadioItem
__ Getters y Setters __    
    +avanzarEstado()
    +esModificable(): boolean
}

class Estacion {
    -nombre: String
    -categorias: List<Categoria>
    -items: List<Item>
__ Getters y Setters __
    +agregarItem(item: Item)
    +avanzarItem(item: Item)
    +aceptaCategoria(categoria: Categoria): boolean
}

class Producto {
    -nombre: String
    -precioDeVenta: number
    -categoria: Categoria
__ Getters y Setters __    
    +getCategoria(): Categoria
    +getPrecio(): number
    +getNombre(): String
}

interface MedioDePago {
    +procesarPago(monto: number): boolean
}

class Efectivo {
    -tipoDePago: string
__ Getters y Setters __
}

class TarjetaDebito {
    -numeroTarjeta: String
    -tipoDePago: string
__ Getters y Setters __
}

class TarjetaCredito {
    -numeroTarjeta: String
    -cuotas: int
    -tipoDePago: string
__ Getters y Setters __
}

class BilleteraVirtual {
    -alias: String
    -tipoDePago: string
__ Getters y Setters __
}

abstract class Descuento {
     +esAplicable(pedido: Pedido, dia: DiaSemana): boolean
     +calcularMontoDescuento(pedido: Pedido): number
}   

class DescuentoEfectivo extends Descuento {
    -porcentaje: number
__ Getters y Setters __
    +esAplicable(pedido: Pedido, dia: DiaSemana): boolean
    +calcularMontoDescuento(pedido: Pedido): number
}

class DescuentoDiaEspecial extends Descuento {
    -diaObjetivo: DiaSemana
    -porcentaje: number
__ Getters y Setters __
    +esAplicable(pedido: Pedido, dia: DiaSemana): boolean
    +calcularMontoDescuento(pedido: Pedido): number
}

enum EstadoPedido {
    EN_CONSTRUCCION,
    CONFIRMADO,
    LISTO,
    FACTURADO
}

enum EstadoItem {
    PENDIENTE,
    EN_PREPARACION,
    LISTO
}

enum DiaSemana {
    LUNES, MARTES, MIERCOLES, JUEVES, VIERNES, SABADO, DOMINGO
}

' Relaciones Estructurales
Restaurante *-- Menu
Restaurante *-- Estacion
Restaurante *-l- Pedido
Restaurante *-r- MedioDePago

Combo ..|> ElementoMenu
Producto ..|> ElementoMenu

Menu *-d- Categoria
Menu *-d- Producto
Menu *-d- Combo

ComboPorcentual .u.|> ComboBeneficio
ComboPrecioFijo .u.|> ComboBeneficio

Combo --> ComboBeneficio

Pedido *-- Item
Item --> ElementoMenu
Estacion o-- Item

Efectivo .u.|> MedioDePago
TarjetaDebito .u.|> MedioDePago
TarjetaCredito .u.|> MedioDePago
BilleteraVirtual .u.|> MedioDePago

Pedido <|-- PedidoSalon
Pedido <|-- PedidoRetirar
Pedido <|-- PedidoEnvioPropio

@enduml