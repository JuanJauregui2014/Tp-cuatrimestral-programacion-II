@startuml -Gestión de Pedidos:-
title -Gestión de Pedidos:-
class Restaurante {
    -nombre: String
    -menu: Menu
    -estaciones: List<Estacion>
    -pedidosActivos: List<Pedido>
    -pedidosFinalizados: List<Pedido>

    +agregarPedido(pedido: Pedido)
    +consultarHistorial(): List<Pedido>
    +facturarPedido(pedido: Pedido)
}

class Menu {
    -categorias: List<Categoria>
    -productos: List<Producto>
    -combos: List<Combo>
}

class Categoria {
    -nombre: String
}

interface ElementoMenu {
    +getPrecio(): number
    +getNombre(): String
}

class Combo implements ElementoMenu {
    -nombre: String
    -productos: List<Producto>
    +getPrecio(): number
    +getNombre(): String
}

interface ComboBeneficio {
    +aplicarBeneficio(precio: number): number
}

class ComboPorcentual implements ComboBeneficio {
    -porcentajeDescuento: number
    +aplicarBeneficio(precio: number): number
}

class ComboPrecioFijo implements ComboBeneficio {
    -precioFijo: number
    +aplicarBeneficio(precio: number): number
}

abstract class Pedido {
    -numeroPedido: int

    -nombreCliente: String

    -fecha: Date

    -estado: EstadoPedido

    -item: List<Item>



    +agregarItem(item:Item)

    +quitarItem(item:Item)

    +registrarPedido()

    +deshacerModificacion()

    +confirmarPedido()

    +puedeFacturable()

    +totalPedido()

}

class PedidoSalon{

    -numeroMesa: int

    -mozo: String

}

class PedidoRetirar{

    -horarioRetiro: Date

}

class PedidoEnvioPropio{

    -direccion: String
    -costoEnvio: number
}

class Item {
    -cantidad: int
    -estado: EstadoItem
    
    +avanzarEstado()

    +esModificable()



}

class Producto implements ElementoMenu{

    -nombre: String

    -precioDeVenta:number



    +getPrecio(): number

    +getNombre(): String



   

}

class Combo implements ElementoMenu {

    -nombre: String

    -productos: List<Producto>

    -precioEspecial: number

    +getPrecio(): number

    +getNombre(): String

}

class Categoria{



}

class Estacion{

    -nombre: String

    -items:List<Item>



    +agregarItem(item:Item)

    +avanzarItem(item:Item)



}



class Menu{

    -categorias: List<Categoria>

    -combos: List<Combo>

    -productos: List<Producto>



}

'preguntas si conviene  tenerlo como clase abstracta y que hereden los distintos medios de pagos'

class MedioDePago{



}

enum EstadoPedido {

    EN_CONSTRUCCION,

    CONFIRMADO,

    LISTO,

    FACTURADO

}

enum EstadioItem{

    PENDIENTE,

    EN_PREPARACION,

    LISTO

}

Pedido <|-l- PedidoSalon

Pedido <|-- PedidoRetirar

Pedido <|-r- PedidoEnvioPropio

Menu o-l- Categoria

Producto *-d- Menu

Menu *-- Combo

Estacion -- Item

Item --> ElementoMenu

@enduml